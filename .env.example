# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics (optionnel)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Paiement automatique MTN/Airtel MoMo (optionnel — désactivé par défaut)
# Une fois "true", EscrowPaymentPage propose le paiement automatique en
# plus de l'upload de preuve manuel. Les secrets provider (clés API,
# secrets webhook, PAYMENTS_MOCK_MODE) ne vont PAS ici : ce sont des
# secrets de fonction Edge Supabase (Deno.env.get côté serveur), jamais
# des variables VITE_ exposées au client.
VITE_MOMO_AUTOPAY_ENABLED=false
